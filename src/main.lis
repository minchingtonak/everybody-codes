import "go:fmt"

import q1 "quests/one"
import q2 "quests/two"
import q3 "quests/three"

fn main() {
  fmt.Println("Quest 1")
  for (idx, solution) in [
    q1.part1_solution,
    q1.part2_solution,
    q1.part3_solution,
  ].enumerate() {
    fmt.Println(f"Part {idx + 1}: {solution()} pinecones")
  }

  if let Result.Err(e) = quest2() { fmt.Println(e.Error()) }

  if let Result.Err(e) = quest3() { fmt.Println(e.Error()) }
}

fn quest2() -> Result<int, error> {
  fmt.Println("Quest 2")
  for (idx, solution) in [q2.part1_solution, q2.part2_solution].enumerate() {
    fmt.Println(f"Part {idx + 1} checksum: {solution()?}")
  }

  // don't love this
  Result.Ok(0)
}

fn quest3() -> Result<int, error> {
  fmt.Println("Quest 3")
  for (idx, solution) in [q3.part1_solution, q3.part2_solution].enumerate() {
    fmt.Println(f"Part {idx + 1}: {solution()?}")
  }

  Result.Ok(0)
}
