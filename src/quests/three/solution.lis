import "go:fmt"
import "go:math"
import "go:slices"
import "go:strconv"
import "go:strings"

fn part1_2_solution(votes: string) -> Result<int, error> {
  let parsed_votes = parse_input(votes)?

  Result.Ok(parsed_votes.map(|v| v.to_decimal()).fold(0, |acc, curr| acc + curr))
}

pub fn part1_solution() -> Result<int, error> {
  let votes = get_part1_input()

  part1_2_solution(votes)
}

pub fn part2_solution() -> Result<int, error> {
  let votes = get_part2_input()

  part1_2_solution(votes)
}

pub fn part3_solution() -> Result<int, error> {
  let votes = get_part3_input()

  let parsed_votes = parse_input(votes)?

  Result.Ok(parsed_votes
    .filter(|v| v.is_smallest())
    .map(|v| v.to_decimal())
    .fold(0, |acc, curr| acc + curr))
}

#[display]
struct IsoNumber { version: int, base: Slice<int>, digits: Slice<int> }

impl IsoNumber {
  fn to_decimal(self) -> int {
    // ISO-13 777 -> ISO-313 777
    // ISO-789 2465112 -> ISO-9789789 2465112
    // ISO-2341 945 -> ISO-341 945
    let mut result = 0
    for (idx, digit) in self.digits.enumerate() {
      let offset = if self.digits.length() > self.base.length() {
        // more digits than base
        // idx must be offset to the left
        self.digits.length() - self.base.length()
      } else if self.digits.length() == self.base.length() {
        // not necessary but more explicit
        0
      } else {
        // more base than digits
        // idx must be offset to the right
        -(self.base.length() - self.digits.length())
      }

      let base = self.base[mod((idx - offset), self.base.length())]
      let exp = self.digits.length() - (idx + 1)

      result += (digit * pow(base, exp))
    }

    result
  }

  fn digits_as_decimal(self) -> int {
    let mut exp = self.digits.length() - 1
    let mut result = 0
    for digit in self.digits {
      result += digit * pow(10, exp)
      exp -= 1
    }

    result
  }

  fn is_smallest(self) -> bool {
    if self.version != 2 { return true }

    let decimal = self.to_decimal()
    let digits = self.digits_as_decimal()
    for offset in 0..(digits - 1) {
      let i = digits - 1 - offset
      let num = IsoNumber {
        version: 2,
        base: self.base,
        digits: int_to_slice(i),
      }
      if num.to_decimal() == decimal { return false }
    }
    true
  }
}

// % in Go is the remainder, not modulo
// this implements modulo as it exists in python
// which properly handles negative numbers
// (-4 % 3 should be 2), in Go it evals to -1
// https://stackoverflow.com/questions/43018206/modulo-of-negative-integers-in-go
fn mod(a: int, b: int) -> int {
  (a % b + b) % b
}

fn pow(base: int, exp: int) -> int {
  if exp == 0 { return 1 }

  let mut result = base
  for _ in 1..exp {
    result *= base
  }

  result
}

fn int_to_slice(num: int) -> Slice<int> {
  let mut result = Slice.make<int>(f"{num}".length())
  let mut n = num

  for i in 1..=f"{num}".length() {
    let digit = n % 10
    result[result.length() - i] = digit
    n /= 10
  }

  result
}

fn parse_input(input: string) -> Result<Slice<IsoNumber>, error> {
  let input_numbers = strings.Split(input, "\n")

  let mut numbers = Slice.new<IsoNumber>()
  // ISO-3210 7654
  // ISO2-978 99
  for number in input_numbers {
    let split_number = strings.Split(number, " ")
    let base_iso = strings.Split(split_number[0], "-")
    let base = strings.Split(base_iso[1], "")
    let num = strings.Split(split_number[1], "")

    let mut converted_base = Slice.new<int>()
    for digit in base {
      converted_base = converted_base.append(strconv.Atoi(digit)?)
    }

    let mut converted_num = Slice.new<int>()
    for digit in num {
      converted_num = converted_num.append(strconv.Atoi(digit)?)
    }

    let version = if base_iso[0].length() == 3 { 1 } else { 2 }
    numbers = numbers.append(
      IsoNumber { version, base: converted_base, digits: converted_num },
    )
  }

  Result.Ok(numbers)
}
