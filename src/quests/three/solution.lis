import "go:fmt"
import "go:strconv"
import "go:strings"

pub fn part1_solution() -> Result<int, error> {
  let votes = get_part1_input()

  let parsed_votes = parse_input(votes)?

  Result.Ok(parsed_votes.map(|v| v.to_decimal()).fold(0, |acc, curr| acc + curr))
}

pub fn part2_solution() -> Result<int, error> {
  let votes = get_part2_input()

  let parsed_votes = parse_input(votes)?

  Result.Ok(parsed_votes.map(|v| v.to_decimal()).fold(0, |acc, curr| acc + curr))
}

#[display]
struct IsoNumber { base: Slice<int>, digits: Slice<int> }

impl IsoNumber {
  fn to_decimal(self) -> int {
    // TODO fix code to properly repeat from right to left
    // ISO-13 777 -> ISO-313 777
    // ISO-789 2465112 -> ISO-9789789 2465112
    let mut result = 0
    for (idx, digit) in self.digits.enumerate() {
      let base = self.base[idx % self.base.length()]
      let exp = self.digits.length() - (idx + 1)

      fmt.Println(f"{idx % self.base.length()}")
      fmt.Println(f"{digit}*{base}^{exp}")

      result += (digit *
      pow(self.base[idx % self.base.length()], self.digits.length() - (idx + 1)))
    }
    fmt.Println(f"={result}")
    fmt.Println()

    result
  }
}

fn pow(base: int, exp: int) -> int {
  if exp == 0 { return 1 }

  let mut result = base
  for _ in 1..exp {
    result *= base
  }

  result
}

fn parse_input(input: string) -> Result<Slice<IsoNumber>, error> {
  let input_numbers = strings.Split(input, "\n")

  let mut numbers = Slice.new<IsoNumber>()
  // ISO-3210 7654
  for number in input_numbers {
    let split_number = strings.Split(number, " ")
    let base = strings.Split(strings.Split(split_number[0], "-")[1], "")
    let num = strings.Split(split_number[1], "")

    let mut converted_base = Slice.new<int>()
    for digit in base {
      converted_base = converted_base.append(strconv.Atoi(digit)?)
    }

    let mut converted_num = Slice.new<int>()
    for digit in num {
      converted_num = converted_num.append(strconv.Atoi(digit)?)
    }

    numbers = numbers.append(
      IsoNumber { base: converted_base, digits: converted_num },
    )
  }

  Result.Ok(numbers)
}
