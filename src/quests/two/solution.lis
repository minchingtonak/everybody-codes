import "go:cmp"
import "go:errors"
import "go:slices"
import "go:strconv"
import "go:strings"

pub fn part1_solution() -> Result<int, error> {
  let blade_comparisons = get_part1_input()

  let rows = strings.Split(blade_comparisons, "\n")

  let mut checksum = 0
  // parse input
  // split by spaces, then split each triplet into three chars
  for line in rows {
    let triplets = strings.Split(line, " ")
    let mut counts = Array.new<int, 5>()
    for triplet in triplets {
      let [l, op, r] = strings.Split(triplet, "") else {
        return Result.Err(errors.New("triplet is not 3 characters"))
      }

      let l_idx = (strconv.Atoi(l)?) - 1
      let r_idx = (strconv.Atoi(r)?) - 1

      if op == ">" { counts[l_idx] += 1 } else { counts[r_idx] += 1 }
    }

    let mut indices = Slice.make<int>(counts.length())
    for idx in 0..indices.length() {
      indices[idx] = idx
    }

    slices.SortStableFunc(indices, |a, b| cmp.Compare(counts[b], counts[a]))

    let joined = strings.Join(indices.map(|idx| strconv.Itoa(idx + 1)), "")

    checksum += strconv.Atoi(joined)?
  }

  Result.Ok(checksum)
}
