import "go:cmp"
import "go:errors"
import "go:slices"
import "go:strconv"
import "go:strings"

// correct answer: 332034
pub fn part1_solution() -> Result<int, error> {
  let blade_comparisons = get_part1_input()

  let triplet_rows = parse_input(blade_comparisons)?

  let mut checksum = 0
  for row in triplet_rows {
    let mut counts = Array.new<int, 5>()
    for triplet in row {
      if triplet.op == Operation.GreaterThan {
        counts[triplet.left - 1] += 1
      } else {
        counts[triplet.right - 1] += 1
      }
    }

    let mut indices = Slice.make<int>(counts.length())
    for idx in 0..indices.length() {
      indices[idx] = idx
    }

    slices.SortStableFunc(indices, |a, b| cmp.Compare(counts[b], counts[a]))

    let joined = indices.map(|idx| strconv.Itoa(idx + 1)).join("")

    checksum += strconv.Atoi(joined)?
  }

  Result.Ok(checksum)
}

enum Operation {
  LessThan,
  GreaterThan,
}

struct Triplet { left: int, op: Operation, right: int }

type TripletMatrix = Slice<Slice<Triplet>>

type ParseResult = Result<TripletMatrix, error>

fn parse_input(input: string) -> ParseResult {
  let rows = strings.Split(input, "\n")

  let mut results: TripletMatrix = Slice.new().reserve(rows.length())
  for line in rows {
    let triplets = strings.Split(line, " ")
    let mut row_result = Slice.new<Triplet>().reserve(triplets.length())
    for triplet in triplets {
      let [l, op, r] = strings.Split(triplet, "") else {
        return Result.Err(errors.New("triplet is not 3 characters"))
      }

      let op = match op {
        ">" => Operation.GreaterThan,
        "<" => Operation.LessThan,
        _ => {
          return Result.Err(errors.New(f"operator '{op}' is invalid"))
        },
      }
      row_result = row_result.append(
        Triplet { op, left: strconv.Atoi(l)?, right: strconv.Atoi(r)? },
      )
    }

    results = results.append(row_result)
  }

  Result.Ok(results)
}
